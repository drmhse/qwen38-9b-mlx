# Python env — rebuilt by hand; patch_mlx_vlm.py re-applies our fixes into it
.venv/

# Prompt-cache disk tier: self-regenerating, ~1.1 GB
.apc-cache/

# 5.6 GB of weights — re-fetch with download.py at the pinned revision.
